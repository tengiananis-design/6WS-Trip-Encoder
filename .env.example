# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets destination
GOOGLE_SHEETS_ID=your_google_spreadsheet_id_here

# Google service account JSON contents OR a path to a JSON file
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service-account.json

# Upload and OCR performance
MAX_UPLOAD_FILES=150
MAX_UPLOAD_SIZE_MB=50
OCR_DPI=200
OCR_MAX_WORKERS=2
PDF_EXTRACTION_WORKERS=2

APP_ENV=production
