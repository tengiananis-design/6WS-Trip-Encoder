# Required for dashboard login (use a long, unique password)
APP_USERNAME=change-this-username
APP_PASSWORD=change-this-long-password

# Required for AI document analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Upload limits (the application reads these exact variable names)
MAX_FILES_PER_BATCH=200
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE_MB=1024

# Optional durable background processing.
# Configure BOTH Redis and S3 storage together; otherwise the app uses
# local background processing, which is not restart-safe.
# REDIS_URL=redis://...
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://...
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Google Sheets export is not enabled in this test build.
